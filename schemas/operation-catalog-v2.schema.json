{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate-ci.mindclade.dev/schemas/operation-catalog-v2.schema.json",
  "title": "Capability-aware estate operation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "connected", "repositories"],
  "properties": {
    "schema_version": {"const": "estate.operation-catalog/v2"},
    "connected": {"type": "boolean"},
    "repositories": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "main_branch", "operations"],
        "properties": {
          "repository": {"type": "string", "pattern": "^mindclade/(\\.github|[a-z0-9][a-z0-9._-]{0,99})$"},
          "main_branch": {"const": "main"},
          "operations": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "refresh_estate_health": {"$ref": "#/$defs/capability"},
              "rerun_failed_required_workflow": {"$ref": "#/$defs/capability"},
              "cancel_superseded_workflow_run": {"$ref": "#/$defs/capability"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "enabled"],
      "properties": {"workflow_id": {"type": "integer", "minimum": 1}, "enabled": {"type": "boolean"}}
    }
  }
}
