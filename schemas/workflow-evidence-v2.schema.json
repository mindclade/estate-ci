{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate-ci.mindclade.dev/schemas/workflow-evidence-v2.schema.json",
  "title": "WorkflowEvidenceV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "workflow_id", "workflow_run_id", "protected_main_sha", "plan_digest", "conclusion", "superseded", "approval", "observed_at", "expires_at", "digest"],
  "properties": {
    "schema_version": {"const": "estate.evidence/v2"},
    "repository": {"type": "string", "pattern": "^mindclade/(\\.github|[a-z0-9][a-z0-9._-]{0,99})$"},
    "workflow_id": {"type": "integer", "minimum": 1},
    "workflow_run_id": {"type": "integer", "minimum": 0},
    "protected_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "conclusion": {"const": "success"},
    "superseded": {"type": "boolean"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "operation", "requested_by", "reason", "approvers", "approved_at", "decision"],
      "properties": {
        "approval_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "operation": {"enum": ["refresh_estate_health", "rerun_failed_required_workflow", "cancel_superseded_workflow_run"]},
        "requested_by": {"type": "string", "maxLength": 320, "pattern": "^[a-z0-9][a-z0-9._+%-]{0,127}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"},
        "reason": {"type": "string", "minLength": 10, "maxLength": 500, "pattern": "^[^\\s\\r\\n\\u0000](?:[^\\r\\n\\u0000]*[^\\s\\r\\n\\u0000])?$"},
        "approvers": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._+%-]{0,127}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"}},
        "approved_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "approved"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
