{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate-ci.mindclade.dev/schemas/estate-health-v1.schema.json",
  "title": "EstateHealthSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "observed_at", "protected_main_sha", "summary", "repositories", "digest"],
  "properties": {
    "schema_version": {"const": "estate.health/v1"},
    "snapshot_id": {"$ref": "#/$defs/uuidv4"},
    "observed_at": {"type": "string", "format": "date-time"},
    "protected_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["healthy", "degraded", "blocked", "unknown"],
      "properties": {
        "healthy": {"type": "integer", "minimum": 0}, "degraded": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "repositories": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {"$ref": "#/$defs/repositoryHealth"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuidv4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "repositoryHealth": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "profile", "head_sha", "last_green_sha", "required_check_status", "queue_seconds", "execution_seconds", "failure_class", "cache_hit_basis_points", "evidence_digest", "observed_at"],
      "properties": {
        "repository": {"type": "string", "pattern": "^mindclade/(\\.github|[a-z0-9][a-z0-9._-]{0,99})$"},
        "profile": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\s\\r\\n\\u0000](?:[^\\r\\n\\u0000]*[^\\s\\r\\n\\u0000])?$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "last_green_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_check_status": {"enum": ["success", "failure", "blocked", "unknown"]},
        "queue_seconds": {"type": "integer", "minimum": 0},
        "execution_seconds": {"type": "integer", "minimum": 0},
        "failure_class": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[^\\s\\r\\n\\u0000](?:[^\\r\\n\\u0000]*[^\\s\\r\\n\\u0000])?$"},
        "cache_hit_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
