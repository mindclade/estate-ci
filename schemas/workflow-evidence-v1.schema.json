{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate-ci.mindclade.dev/schemas/workflow-evidence-v1.schema.json",
  "title": "WorkflowEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "workflow_id", "workflow_run_id", "protected_main_sha", "plan_digest", "conclusion", "superseded", "approval", "observed_at", "expires_at", "digest"],
  "properties": {
    "schema_version": {"const": "estate.evidence/v1"},
    "repository": {"type": "string", "pattern": "^mindclade/(\\.github|[a-z0-9][a-z0-9._-]{0,99})$"},
    "workflow_id": {"type": "integer", "minimum": 1},
    "workflow_run_id": {"type": "integer", "minimum": 0},
    "protected_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "conclusion": {"const": "success"},
    "superseded": {"type": "boolean"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["approvers", "approved_at", "decision"],
      "properties": {
        "approvers": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._+%-]{0,127}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"}},
        "approved_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "approved"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
