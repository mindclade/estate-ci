{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate-ci.mindclade.dev/schemas/operation-dispatch-result-v1.schema.json",
  "title": "OperationDispatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "request_digest", "receipt_id", "status", "reason_code", "provider_reference", "recorded_at", "digest", "signature"],
  "properties": {
    "schema_version": {"const": "estate.operation-dispatch-result/v1"},
    "request_id": {"$ref": "operation-request-v1.schema.json#/$defs/uuidv4"},
    "request_digest": {"$ref": "operation-request-v1.schema.json#/$defs/digest"},
    "receipt_id": {"$ref": "operation-request-v1.schema.json#/$defs/uuidv4"},
    "status": {"enum": ["accepted", "rejected"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "provider_reference": {"type": "string", "maxLength": 512, "pattern": "^((https://|simulation://)[^\\r\\n\\u0000]*|)$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "digest": {"$ref": "operation-request-v1.schema.json#/$defs/digest"},
    "signature": {"$ref": "operation-request-v1.schema.json#/$defs/signature"}
  }
}
