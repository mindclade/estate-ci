{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate-ci.mindclade.dev/schemas/operation-request-v1.schema.json",
  "title": "OperationRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "operation", "repository", "workflow_id", "workflow_run_id", "protected_main_sha", "plan_digest", "evidence_digest", "reason", "requested_by", "issued_at", "expires_at", "nonce", "digest", "signature"],
  "properties": {
    "schema_version": {"const": "estate.operation-request/v1"},
    "request_id": {"$ref": "#/$defs/uuidv4"},
    "operation": {"enum": ["refresh_estate_health", "rerun_failed_required_workflow", "cancel_superseded_workflow_run"]},
    "repository": {"type": "string", "pattern": "^mindclade/(\\.github|[a-z0-9][a-z0-9._-]{0,99})$"},
    "workflow_id": {"type": "integer", "minimum": 1},
    "workflow_run_id": {"type": "integer", "minimum": 0},
    "protected_main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"},
    "reason": {"type": "string", "minLength": 10, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$"},
    "requested_by": {"type": "string", "maxLength": 320, "pattern": "^[a-z0-9][a-z0-9._+%-]{0,127}@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "digest": {"$ref": "#/$defs/digest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uuidv4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    }
  }
}
